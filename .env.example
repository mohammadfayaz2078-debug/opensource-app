# Bazarnet ERP — copy this file to `.env` and fill in your own values.
# Never commit a real `.env` file.

APP_NAME="Bazarnet ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# SQLite is the quickest way to try the app locally:
#   touch database/database.sqlite
# MySQL is recommended for production:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=bazarnet
#   DB_USERNAME=root
#   DB_PASSWORD=
DB_CONNECTION=sqlite
DB_DATABASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Comma-separated list of frontend domains that may use cookie-based auth.
# With the default setup (tokens only) localhost values are sufficient.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3-compatible object storage (leave empty to use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend build variables (Vite). When the API and the SPA are served from
# the same origin (Laravel + `public/build`), the default base URL works.
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE=http://127.0.0.1:8000/

# ─────────────────────────────────────────────────────────────────────────────
# DEMO ONLY — the `php artisan db:seed` seeder creates these accounts with
# these passwords so a fresh install is explorable. CHANGE THEM IMMEDIATELY
# on any shared or production deployment:
#
#   Super admin : superadmin@gmail.com / admin
#   Company admin: admin@gmail.com      / admin@123
#   Branch user  : user1@gmail.com      / admin@123
# ─────────────────────────────────────────────────────────────────────────────
